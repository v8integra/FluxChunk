{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxChunk",
  "version": "0.1.0",
  "identifier": "com.fluxchunk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FluxChunk",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRUUzQkIxMzA3QjNCRUMKUldUc08zc3dzVHZ1WE51dGFrWTI1WUw0NjE3bUlMcm1PUUVpQXFWM25MMDd0anQ1UjFIZHVuQmgK",
      "endpoints": [
        "https://github.com/v8integra/FluxChunk/releases/latest/download/latest.json"
      ]
    }
  }
}
